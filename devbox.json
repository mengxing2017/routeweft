  "shell": {
    "init_hook": [
      "rustup show active-toolchain",
      "cargo fetch --manifest-path backend/Cargo.toml --locked"
    ],
    "scripts": {
      "start": "cargo run --manifest-path backend/Cargo.toml -p routeweft-daemon --",
      "test": "cargo test --manifest-path backend/Cargo.toml --workspace",
      "build": "cargo build --manifest-path backend/Cargo.toml --workspace",
      "build-docs": "cargo doc --manifest-path backend/Cargo.toml --workspace --no-deps",
      "fmt": "cargo fmt --manifest-path backend/Cargo.toml --all",
      "format": "cargo fmt --manifest-path backend/Cargo.toml --all",
      "check": "cargo check --manifest-path backend/Cargo.toml --workspace",
      "clippy": "cargo clippy --manifest-path backend/Cargo.toml --workspace --all-targets -- -D warnings",
      "ci": "make check",
      "web": "pnpm --dir frontend dev",
      "check-frontend": "make check-frontend",
      "release:check": "make release-check",
      "release:dry-run": "make release-dry-run",
      "release:publish": "make release-publish",
      "release:frontend:dry-run": "make release-frontend-dry-run",
      "release:frontend:publish": "make release-frontend-publish"
    }
  }
}
