# Copy to .private-release.env, fill in the two values, then:
# set -a; source .private-release.env; set +a
# Never commit the actual index or token.
CARGO_REGISTRIES_INTERNAL_INDEX=''
CARGO_REGISTRIES_INTERNAL_TOKEN=''

# Optional: frontend npm registry (not the Cargo index).
NPM_REGISTRY_INTERNAL=''
NPM_TOKEN_INTERNAL=''
