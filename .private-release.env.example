# 私有 Cargo 索引地址和发布 token
CARGO_REGISTRIES_INTERNAL_INDEX=''
CARGO_REGISTRIES_INTERNAL_TOKEN=''

# 公共仓库发布时填写；仅发布私有仓库可留空
CARGO_REGISTRY_TOKEN=''

# 前端接口包发布（仅发布前端时填写；HTTPS npm registry）
NPM_REGISTRY=''
NPM_TOKEN=''

# 构建依赖下载源，与发布目标独立；留空默认 npmjs，可改为 npm group/proxy
NPM_INSTALL_REGISTRY=''
# 仅当下载源需要认证时填写读权限 token；不会复用 NPM_TOKEN
NPM_INSTALL_TOKEN=''
